<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Flat brand green only. The animation is drawn in Compose (QuranSplash) instead: the system
         splash caps its icon animation at 1000ms, and some OEM skins never render it at all. Same
         colour on both sides, so the hand-off to the Compose splash is invisible. -->
    <style name="Theme.NoorQuran.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#1E7D55</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_empty</item>
        <item name="postSplashScreenTheme">@android:style/Theme.Material.Light.NoActionBar</item>
    </style>
</resources>
