TEAM_ID=

PRODUCT_NAME=Noor e Islam
PRODUCT_BUNDLE_IDENTIFIER=com.kodeelite.nooreislam$(TEAM_ID)$(BUNDLE_SUFFIX)

// Debug installs alongside the store build: own bundle id, own data, "(dev)" on the home screen.
// Nested lookup — Xcode expands $(CONFIGURATION) to Debug or Release first.
BUNDLE_SUFFIX=$(BUNDLE_SUFFIX_$(CONFIGURATION))
BUNDLE_SUFFIX_Debug=.dev
BUNDLE_SUFFIX_Release=

APP_DISPLAY_NAME=$(APP_DISPLAY_NAME_$(CONFIGURATION))
APP_DISPLAY_NAME_Debug=Noor e Islam (dev)
APP_DISPLAY_NAME_Release=Noor e Islam

CURRENT_PROJECT_VERSION=12
MARKETING_VERSION=1.0.0
